/vendor/
/tmp/*
!/tmp/.gitkeep
# Frontend build-output — gegenereerd door `npm --prefix web run build`.
/public/index.html
/public/assets/
/web/node_modules/
/web/dist/
*.sqlite
*.sqlite-journal
*.csv
*.xlsx
*.xls
*.txt
.~lock.*
.env
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
output.txt

# migratie-mapping is wél onderdeel van de tooling
!migration/*.csv

# Python bytecode-cache (migratiescripts)
__pycache__/
*.pyc

# One-off WooCommerce-migratie, bewust niet versioneren
migration/reanibex-multilang-attributes.py

# Work-folder voor ad-hoc analyses en uitdraaien (bewust niet versioneren)
work/

# Afbeeldingen (Cas 14 sep 2026): screenshots/foto's horen niet in de repo
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.PNG
*.gif
*.webp
*.heic
*.bmp
*.tif
*.tiff
